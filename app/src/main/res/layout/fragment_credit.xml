<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="@string/fragment_credit_textViewCreditTitle"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
        android:id="@+id/fragment_credit_textViewCreditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/fragment_credit_textViewCreditText"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBody1" />

    <TextView
        android:id="@+id/fragment_credit_textViewVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:text="@string/fragment_credit_version"
        android:textAppearance="?attr/textAppearanceCaption" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="@string/fragment_credit_textViewVerseTitle"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:autoLink="web"
        android:focusable="true"
        android:text="@string/fragment_credit_textViewVerseText"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBody1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:text="@string/fragment_credit_textViewThanksTitle"
        android:textAppearance="?android:attr/textAppearanceLarge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:autoLink="web"
        android:focusable="true"
        android:text="@string/fragment_credit_textViewThanksText"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBody1" />

    <TextView
        android:id="@+id/fragment_credit_textViewCopyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:text="@string/youversion_copyright_notice"
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceCaption" />

</LinearLayout>